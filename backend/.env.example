# Copiar este archivo como .env y completar los valores. No subir .env a GitHub.

# Base de datos (local con docker-compose). En AWS se reemplaza por la dirección de Amazon RDS.
# El puerto (5440) debe coincidir con el de docker-compose.yml.
DATABASE_URL=postgresql+psycopg://gympro:gympro@localhost:5440/gympro

# Seguridad (JWT)
# Texto largo y aleatorio con el que se firman las sesiones. Para generar uno:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiar-por-un-texto-largo-y-aleatorio
TOKEN_EXPIRA_MINUTOS=480
RESET_EXPIRA_MINUTOS=30

# Administrador de demostración (se crea solo al encender la API la primera vez).
# ¡Cambiar estos valores antes de publicar el sistema en internet!
ADMIN_EMAIL=admin@gympro.com
ADMIN_PASSWORD=admin1234
ADMIN_NOMBRE=Administrador GymPro

# Frontend permitido (CORS) y dirección base de los enlaces de recuperación de contraseña
FRONTEND_URL=http://localhost:5173

# Correo (todavía no se usa: por ahora los correos se muestran en la consola). En AWS: Amazon SES.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USUARIO=
SMTP_PASSWORD=
CORREO_REMITENTE=no-responder@gympro.local

# Reglas de negocio
ZONA_HORARIA=America/Bogota
DIAS_POR_VENCER=5
DIAS_AVISO_VENCIMIENTO=3
# Alertas automáticas de vencimiento: tarea diaria a esta hora (Colombia). ALERTAS_ACTIVAS=false las apaga.
ALERTAS_ACTIVAS=true
HORA_ALERTAS=6
# (las siguientes se usan desde el Sprint 2)
DIAS_SIN_ASISTIR_RECORDATORIO=7
META_SEMANAL_DEFECTO=3
